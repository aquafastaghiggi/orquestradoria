{
  "name": "ai-orchestrator",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"pnpm --filter @orchestrator/api dev\" \"pnpm --filter @orchestrator/web dev\"",
    "build": "pnpm -r build",
    "doctor": "pnpm --filter @orchestrator/api doctor",
    "typecheck": "pnpm -r build && pnpm -r typecheck",
    "test": "pnpm -r build && pnpm --filter @orchestrator/api test",
    "lint": "pnpm -r lint",
    "predev": "pnpm build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22 <24",
    "pnpm": ">=9"
  }
}
